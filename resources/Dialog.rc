#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "DialogIds.h"
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
IDD_EXPORT DIALOGEX 0, 0, 360, 269
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "BLP 导出设置"
FONT 10, "Microsoft YaHei UI", 400, 0, 1
BEGIN
    LTEXT "BLP 导出设置", IDC_TITLE, 20, 15, 310, 24
    LTEXT "保存后自动用于后续导出，不再逐次询问。", IDC_DOCUMENT, 21, 44, 317, 15
    LTEXT "JPEG 质量", IDC_QUALITY_LABEL, 21, 77, 180, 16
    EDITTEXT IDC_QUALITY, 278, 73, 60, 22, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 18, 101, 323, 21
    LTEXT "1–100，数值越高，保留细节越多。", -1, 21, 125, 317, 14
    LTEXT "Mipmap Count", IDC_MIP_LABEL, 21, 151, 182, 16
    COMBOBOX IDC_LEVELS, 246, 147, 92, 165, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "默认 16；按图像尺寸自动取可用层数，包含原图。", -1, 21, 175, 317, 14
    LTEXT "Alpha 来源", IDC_ALPHA_LABEL, 21, 200, 84, 16
    COMBOBOX IDC_ALPHA, 105, 195, 233, 100, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_ERROR, 21, 220, 317, 14
    PUSHBUTTON "恢复默认", IDC_RESET, 21, 240, 85, 22, BS_OWNERDRAW
    PUSHBUTTON "取消", IDCANCEL, 180, 240, 73, 22, BS_OWNERDRAW
    DEFPUSHBUTTON "保存设置", IDOK, 264, 240, 74, 22, BS_OWNERDRAW
END
